Algoritmo "Operadores"
Var
   A, B, C: Inteiro
Inicio
      A <- 2
      B <- 3
      C <- 5
      Escreval ("1. ", (A>B))
      Escreval ("2. ", (A=2))
      Escreval ("3. ", (C=B+A))
      Escreval ("4. ", (A=B) ou (C>A))
      Escreval ("5. ", (não(A=B) ou (C>A)))
      Escreval ("6. ", (A=B) e (C>A))
Fimalgoritmo