Algoritmo "Conte_ate_10"
Var
   contador: Inteiro
Inicio
   contador <- 0
   Enquanto (contador <=10) Faca
            EscrevaL (contador)
            contador <- contador +1
   FimEnquanto
   CONTADOR <- 10
   Enquanto (contador >= 0) Faca
            EscrevaL (contador)
            contador <- contador -2
   FimEnquanto
Fimalgoritmo