Algoritmo "Leia"

Var
   Nome: Caractere
   N1, N2, S: Inteiro
Inicio
   Escreva ("Digite seu nome: ")
   Leia (Nome)
   Escreval ("Seu nome é: ", Nome," Vamos somar.")
   Escreval ("Digite um número: ")
   Leia (N1)
   Escreval ("Digite outro número: ")
   Leia (N2)
   S <- N1 + N2
   Escreva ("A soma entre ", N1, " e ",N2," é igual a: ", S)
Fimalgoritmo