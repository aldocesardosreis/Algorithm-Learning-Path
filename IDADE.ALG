Algoritmo "Idade"
Var
   ano_atual: Inteiro
   ano_nasc: Inteiro
   idade: Inteiro
Inicio
      Escreval ("Em que anos nós estamos?")
      Leia (ano_atual)
      Escreval ("Em que ano eu nasci?")
      Leia (ano_nasc)
      idade <- ano_atual - ano_nasc
      Escreval ("Minha idade será: ", idade)
Fimalgoritmo